{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlekseiUL/gpt-image-2-agent-kit/schemas/identity.v1.schema.json",
  "title": "GPT Image 2 Agent Kit identity manifest v1",
  "type": "object",
  "required": ["schema", "name", "notes", "refs"],
  "properties": {
    "schema": {"const": "gpt-image2-agent.identity.v1"},
    "name": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "source_name", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "source_name": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
